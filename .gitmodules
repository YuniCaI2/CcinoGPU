[submodule "ThirdPart/VulkanMemoryAllocator"]
	path = ThirdPart/VulkanMemoryAllocator
	url = https://github.com/GPUOpen-LibrariesAndSDKs/VulkanMemoryAllocator.git
[submodule "ThirdPart/glm"]
	path = ThirdPart/glm
	url = https://github.com/g-truc/glm.git
[submodule "ThirdPart/googletest"]
	path = ThirdPart/googletest
	url = https://github.com/google/googletest.git
[submodule "ThirdPart/llvm-project"]
	path = ThirdPart/llvm-project
	url = https://github.com/llvm/llvm-project.git
	# --remote follows release/23.x; normal updates use the parent repository's pinned commit.
	branch = release/23.x
	shallow = true
[submodule "ThirdPart/json"]
	path = ThirdPart/json
	url = https://github.com/nlohmann/json.git
	shallow = true
[submodule "ThirdPart/glslang"]
	path = ThirdPart/glslang
	url = https://github.com/KhronosGroup/glslang.git
[submodule "ThirdPart/SDL"]
	path = ThirdPart/SDL
	url = https://github.com/libsdl-org/SDL.git
[submodule "ThirdPart/imgui"]
	path = ThirdPart/imgui
	url = https://github.com/ocornut/imgui.git
	shallow = true
